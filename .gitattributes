# Store text files with LF line endings in the repository on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.woff2 binary
*.ttf binary
