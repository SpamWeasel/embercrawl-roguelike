{
  // Electron main process, preload, shared types, tests and tool configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"]
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "src/engine",
    "tests",
    "scripts",
    "*.config.ts",
    "*.config.mts",
    "vite.renderer.ts"
  ]
}
